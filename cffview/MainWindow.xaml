<Window x:Class="cffview.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:cffview.ViewModels"
        xmlns:converters="clr-namespace:cffview.Converters"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        mc:Ignorable="d"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        PreviewKeyDown="Window_PreviewKeyDown"
        Title="CFF View"
        Icon="Assets/app.ico"
        Height="700" Width="940"
        MinHeight="500" MinWidth="720"
        WindowStyle="None"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource AppBackground}"
        d:DataContext="{d:DesignInstance vm:MainViewModel}">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="46"
                            ResizeBorderThickness="5"
                            UseAeroCaptionButtons="False"
                            GlassFrameThickness="0,0,0,1"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <converters:BoolToVisibilityConverter      x:Key="BoolToVis"/>
        <converters:NullToVisibilityConverter      x:Key="NullToVis"/>
        <converters:DelayToColorConverter          x:Key="DelayToColor"/>
        <converters:TimeFormatConverter            x:Key="TimeFormat"/>
        <converters:LineColorConverter             x:Key="LineColor"/>
        <converters:CountToVisibilityConverter     x:Key="CountToVis"/>
        <converters:BoolToThemeIconConverter       x:Key="ThemeIcon"/>
        <converters:DelayedToColorConverter        x:Key="DelayedToColor"/>
        <converters:WindowStateToIconConverter     x:Key="WinStateIcon"/>

        <!-- Window control buttons (min / max / close) -->
        <Style x:Key="WinCtrlBtn" TargetType="Button">
            <Setter Property="Background"     Value="Transparent"/>
            <Setter Property="Foreground"     Value="#FFCCCC"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width"          Value="42"/>
            <Setter Property="Height"         Value="46"/>
            <Setter Property="FontSize"       Value="14"/>
            <Setter Property="Cursor"         Value="Arrow"/>
            <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#33FFFFFF"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#55FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="WinCloseBtn" TargetType="Button">
            <Setter Property="Background"     Value="Transparent"/>
            <Setter Property="Foreground"     Value="#FFCCCC"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width"          Value="42"/>
            <Setter Property="Height"         Value="46"/>
            <Setter Property="FontSize"       Value="14"/>
            <Setter Property="Cursor"         Value="Arrow"/>
            <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E81123"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#C50E1F"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Card -->
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background"    Value="{DynamicResource CardBackground}"/>
            <Setter Property="BorderBrush"   Value="{DynamicResource CardBorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius"  Value="10"/>
            <Setter Property="Margin"        Value="6"/>
            <Setter Property="Padding"       Value="14,12"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.07" Direction="270"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Icon button -->
        <Style x:Key="IconBtn" TargetType="Button">
            <Setter Property="Background"    Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor"        Value="Hand"/>
            <Setter Property="Padding"       Value="6,4"/>
            <Setter Property="Foreground"    Value="{DynamicResource TextMuted}"/>
            <Setter Property="FontSize"      Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource IconButtonHover}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BorderColor}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Primary (red) button -->
        <Style x:Key="PrimaryBtn" TargetType="Button">
            <Setter Property="Background"    Value="{DynamicResource SbbRed}"/>
            <Setter Property="Foreground"    Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding"       Value="14,7"/>
            <Setter Property="FontSize"      Value="12"/>
            <Setter Property="FontWeight"    Value="Medium"/>
            <Setter Property="Cursor"        Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SbbRedDark}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#A00000"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background" Value="#CCCCCC"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Ghost (outline) button for header -->
        <Style x:Key="GhostBtn" TargetType="Button">
            <Setter Property="Background"    Value="Transparent"/>
            <Setter Property="Foreground"    Value="White"/>
            <Setter Property="BorderBrush"   Value="#FFAAAA"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding"       Value="10,6"/>
            <Setter Property="FontSize"      Value="12"/>
            <Setter Property="Cursor"        Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#33FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#55FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Expand/collapse text button -->
        <Style x:Key="ExpandBtn" TargetType="Button">
            <Setter Property="Background"    Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground"    Value="{DynamicResource SbbRed}"/>
            <Setter Property="FontSize"      Value="11"/>
            <Setter Property="Padding"       Value="4,2"/>
            <Setter Property="Cursor"        Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="3" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource IconButtonHover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Departure row template -->
        <DataTemplate x:Key="DepartureRow">
            <Border Margin="0,1" Padding="6,6" CornerRadius="5">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="Transparent"/>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource RowHover}"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="46"/>
                        <ColumnDefinition Width="48"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="48"/>
                    </Grid.ColumnDefinitions>

                    <!-- Line badge -->
                    <Border Grid.Column="0"
                            Background="{Binding Line.Color, Converter={StaticResource LineColor}}"
                            CornerRadius="4" Padding="3,2" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Line.ShortName}"
                                   FontWeight="Bold" Foreground="White" FontSize="11"
                                   HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    </Border>

                    <!-- Departure time -->
                    <TextBlock Grid.Column="1"
                               Text="{Binding DisplayTime, Converter={StaticResource TimeFormat}}"
                               FontSize="14" FontWeight="SemiBold" FontFamily="Consolas"
                               Foreground="{DynamicResource TextPrimary}"
                               VerticalAlignment="Center" Margin="7,0,0,0"/>

                    <!-- Destination -->
                    <TextBlock Grid.Column="2"
                               Text="{Binding Destination}"
                               FontSize="12" Foreground="{DynamicResource TextSecondary}"
                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                               Margin="6,0"/>

                    <!-- Delay badge or "on time" -->
                    <Border Grid.Column="3" VerticalAlignment="Center" Margin="2,0"
                            CornerRadius="3" Padding="5,2"
                            Visibility="{Binding IsDelayed, Converter={StaticResource BoolToVis}}">
                        <Border.Background>
                            <SolidColorBrush Color="#FFEBEE"/>
                        </Border.Background>
                        <TextBlock Text="{Binding DelayMinutes, StringFormat='+{0} min'}"
                                   Foreground="#D32F2F" FontSize="10" FontWeight="SemiBold"/>
                    </Border>

                    <!-- Minutes until / platform -->
                    <StackPanel Grid.Column="4" VerticalAlignment="Center" HorizontalAlignment="Right">
                        <TextBlock Text="{Binding TimeUntilText}"
                                   FontSize="10" FontWeight="Medium"
                                   Foreground="{Binding IsDelayed, Converter={StaticResource DelayedToColor}}"
                                   HorizontalAlignment="Right"/>
                        <TextBlock Text="{Binding Platform}"
                                   FontSize="10" Foreground="{DynamicResource TextMuted}"
                                   HorizontalAlignment="Right"/>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ══════════════════════ HEADER (custom title bar) ══════════════════════ -->
        <Border Grid.Row="0" Background="{DynamicResource SbbRed}"
                MouseLeftButtonDown="Header_MouseLeftButtonDown">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left: logo + badges -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                    <TextBlock FontSize="22" FontWeight="Black" Foreground="White">
                        <Run Text="CFF"/>
                        <Run Text=" View" FontWeight="Light" Foreground="#FFCCCC"/>
                    </TextBlock>
                    <Border Background="#C80000" CornerRadius="4" Padding="7,3" Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="HORAIRES" FontSize="9" FontWeight="Bold" Foreground="#FFE0E0"/>
                    </Border>
                    <Border Background="#B00000" CornerRadius="4" Padding="7,3" Margin="6,0,0,0" VerticalAlignment="Center"
                            Visibility="{Binding IsOffline, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="HORS LIGNE" FontSize="9" FontWeight="Bold" Foreground="#FFE0E0"/>
                    </Border>
                </StackPanel>

                <!-- Center: app actions -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                    <TextBlock Text="{Binding LastRefreshed, StringFormat='Màj {0}'}"
                               FontSize="11" Foreground="#FFAAAA" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <Button Content="{Binding IsDarkMode, Converter={StaticResource ThemeIcon}}"
                            Command="{Binding ToggleThemeCommand}"
                            Style="{StaticResource GhostBtn}"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"
                            Margin="0,0,6,0" ToolTip="Changer le thème" FontSize="14"/>
                    <Button Content="⟳ Actualiser" Command="{Binding RefreshCommand}"
                            Style="{StaticResource GhostBtn}"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"
                            ToolTip="Actualiser tous (Ctrl+R)"/>
                </StackPanel>

                <!-- Right: window controls -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Stretch">
                    <Rectangle Width="1" Fill="#AA000000" Margin="4,8,0,8"/>
                    <Button Style="{StaticResource WinCtrlBtn}"
                            Click="MinimizeWindow" ToolTip="Réduire">
                        <TextBlock Text="—" FontSize="12" VerticalAlignment="Center"/>
                    </Button>
                    <Button Style="{StaticResource WinCtrlBtn}"
                            Click="MaximizeRestoreWindow" ToolTip="Agrandir / Restaurer">
                        <TextBlock Text="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource WinStateIcon}}"
                                   FontSize="12" VerticalAlignment="Center"/>
                    </Button>
                    <Button Style="{StaticResource WinCloseBtn}"
                            Click="CloseWindow" ToolTip="Fermer">
                        <TextBlock Text="✕" FontSize="13" VerticalAlignment="Center"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ══════════════════════ CONTENT ══════════════════════ -->
        <Grid Grid.Row="1">

            <!-- Main scrollable area -->
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="4,0,4,16">

                    <!-- Search box -->
                    <Border Margin="10,10,10,0">
                        <Grid>
                            <TextBox x:Name="SearchBox"
                                     Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                     FontSize="14" Padding="42,10,12,10"
                                     Background="{DynamicResource SearchBackground}"
                                     BorderBrush="{DynamicResource BorderColor}"
                                     BorderThickness="1"
                                     Foreground="{DynamicResource TextPrimary}"
                                     CaretBrush="{DynamicResource TextPrimary}"
                                     GotFocus="SearchBox_GotFocus"
                                     LostFocus="SearchBox_LostFocus"
                                     TextChanged="SearchBox_TextChanged"
                                     KeyDown="SearchBox_KeyDown">
                                <TextBox.Template>
                                    <ControlTemplate TargetType="TextBox">
                                        <Border Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="8">
                                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                                        </Border>
                                    </ControlTemplate>
                                </TextBox.Template>
                            </TextBox>
                            <TextBlock Text="🔍" IsHitTestVisible="False"
                                       FontSize="14" Margin="14,0,0,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="SearchPlaceholder"
                                       Text="Rechercher un arrêt (ex: Lausanne, Genève...)"
                                       IsHitTestVisible="False"
                                       Foreground="{DynamicResource TextMuted}"
                                       FontSize="13" Margin="42,0,0,0" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- Preview card (arrêt sélectionné, pas encore en favoris) -->
                    <Border Margin="10,8,10,4"
                            Visibility="{Binding ShowPreview, Converter={StaticResource BoolToVis}}"
                            Background="{DynamicResource PreviewBackground}"
                            BorderBrush="{DynamicResource SbbRed}"
                            BorderThickness="2" CornerRadius="10" Padding="14,12">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.1" Direction="270"/>
                        </Border.Effect>
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="▶  " Foreground="{DynamicResource SbbRed}" FontSize="13"/>
                                    <TextBlock Text="{Binding SelectedStop.Name}"
                                               FontSize="16" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimary}"/>
                                </StackPanel>

                                <Button Grid.Column="1" Content="⭐  Ajouter aux favoris"
                                        Command="{Binding AddFavoriteCommand}"
                                        Style="{StaticResource PrimaryBtn}"
                                        Margin="8,0"/>

                                <Button Grid.Column="2" Content="✕"
                                        Command="{Binding DismissPreviewCommand}"
                                        Style="{StaticResource IconBtn}"
                                        ToolTip="Fermer (Échap)"/>
                            </Grid>

                            <Rectangle Height="1" Fill="{DynamicResource SeparatorColor}" Margin="0,0,0,6"/>

                            <ItemsControl ItemsSource="{Binding PreviewDepartures}"
                                          ItemTemplate="{StaticResource DepartureRow}"/>
                        </StackPanel>
                    </Border>

                    <!-- Global loading -->
                    <Border Margin="10,6"
                            Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"
                            Background="{DynamicResource CardBackground}"
                            BorderBrush="{DynamicResource CardBorderColor}" BorderThickness="1"
                            CornerRadius="8" Padding="14,10">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="⏳ " FontSize="13"/>
                            <TextBlock Text="Chargement en cours..."
                                       FontSize="13" Foreground="{DynamicResource TextMuted}"/>
                        </StackPanel>
                    </Border>

                    <!-- Error -->
                    <Border Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}"
                            Margin="10,4" Padding="14,10" Background="#FFEBEE"
                            BorderBrush="#EF9A9A" BorderThickness="1" CornerRadius="8">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⚠  " Foreground="#C62828" FontSize="13"/>
                            <TextBlock Text="{Binding ErrorMessage}" Foreground="#C62828" FontSize="13"/>
                        </StackPanel>
                    </Border>

                    <!-- ════════ FAVORITES GRID (2 colonnes) ════════ -->
                    <ItemsControl ItemsSource="{Binding Favorites}" Margin="4,4">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="2"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource CardStyle}">
                                    <StackPanel>
                                        <!-- Card header -->
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0"
                                                       Text="{Binding StopName}"
                                                       FontSize="14" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextPrimary}"
                                                       TextTrimming="CharacterEllipsis"
                                                       VerticalAlignment="Center"/>

                                            <TextBlock Grid.Column="1"
                                                       Text="⏳" FontSize="12"
                                                       VerticalAlignment="Center" Margin="0,0,2,0"
                                                       Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"/>

                                            <Button Grid.Column="2"
                                                    Content="⟳"
                                                    Command="{Binding RefreshDeparturesCommand}"
                                                    Style="{StaticResource IconBtn}"
                                                    ToolTip="Actualiser"/>

                                            <Button Grid.Column="3"
                                                    Content="✕"
                                                    Command="{Binding DataContext.RemoveFavoriteCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource IconBtn}"
                                                    ToolTip="Supprimer"/>
                                        </Grid>

                                        <!-- Line chips (cliquer pour filtrer) -->
                                        <ItemsControl ItemsSource="{Binding LineChips}" Margin="0,0,0,6"
                                                      Visibility="{Binding HasDepartures, Converter={StaticResource BoolToVis}}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel Orientation="Horizontal"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Margin="2,2"
                                                            Command="{Binding DataContext.SelectLineCommand,
                                                                              RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding ShortName}"
                                                            Cursor="Hand"
                                                            ToolTip="{Binding ShortName, StringFormat='Filtrer ligne {0}'}">
                                                        <Button.Template>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border x:Name="Bd"
                                                                        Background="{Binding Color, Converter={StaticResource LineColor}}"
                                                                        CornerRadius="4" Padding="8,4">
                                                                    <Border.Style>
                                                                        <Style TargetType="Border">
                                                                            <Setter Property="Opacity" Value="0.45"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                                    <Setter Property="Opacity" Value="1"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Border.Style>
                                                                    <StackPanel Orientation="Horizontal">
                                                                        <TextBlock Text="{Binding ShortName}"
                                                                                   FontWeight="Bold" Foreground="White" FontSize="11"/>
                                                                        <TextBlock Text=" ✓" FontSize="10" Foreground="White"
                                                                                   Visibility="{Binding IsSelected, Converter={StaticResource BoolToVis}}"/>
                                                                    </StackPanel>
                                                                </Border>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter TargetName="Bd" Property="Opacity" Value="0.8"/>
                                                                    </Trigger>
                                                                    <Trigger Property="IsPressed" Value="True">
                                                                        <Setter TargetName="Bd" Property="Opacity" Value="1"/>
                                                                    </Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Button.Template>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <Rectangle Height="1" Fill="{DynamicResource SeparatorColor}" Margin="0,0,0,6"/>

                                        <!-- Departures list -->
                                        <ItemsControl ItemsSource="{Binding VisibleDepartures}"
                                                      ItemTemplate="{StaticResource DepartureRow}"
                                                      Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}"/>

                                        <!-- No departures / no match -->
                                        <TextBlock FontSize="12" Foreground="{DynamicResource TextMuted}"
                                                   Margin="0,8" HorizontalAlignment="Center"
                                                   Visibility="{Binding ShowNoDepartures, Converter={StaticResource BoolToVis}}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="Aucun départ disponible"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasLineFilter}" Value="True">
                                                            <Setter Property="Text" Value="Aucun départ pour cette ligne"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>

                                        <!-- Expand / collapse -->
                                        <Button Content="{Binding ExpandLabel}"
                                                Command="{Binding ToggleExpandCommand}"
                                                Style="{StaticResource ExpandBtn}"
                                                HorizontalAlignment="Center"
                                                Margin="0,6,0,0"
                                                Visibility="{Binding HasDepartures, Converter={StaticResource BoolToVis}}"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Empty state -->
                    <Border Margin="0,50"
                            Visibility="{Binding ShowEmptyState, Converter={StaticResource BoolToVis}}">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="🚉" FontSize="56" HorizontalAlignment="Center" Margin="0,0,0,16"/>
                            <TextBlock Text="Aucun arrêt en favoris"
                                       FontSize="20" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextSecondary}"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="Recherchez un arrêt ci-dessus et ajoutez-le&#x0a;pour retrouver ses horaires en un coup d'oeil."
                                       FontSize="13" Foreground="{DynamicResource TextMuted}"
                                       HorizontalAlignment="Center" TextAlignment="Center"
                                       Margin="0,10,0,0" LineHeight="22"/>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>

            <!-- Search results OVERLAY (par-dessus le contenu) -->
            <Border Panel.ZIndex="100"
                    VerticalAlignment="Top" HorizontalAlignment="Stretch"
                    Margin="10,58,10,0"
                    Visibility="{Binding ShowSearchResults, Converter={StaticResource BoolToVis}}">
                <Border Background="{DynamicResource DropdownBackground}"
                        BorderBrush="{DynamicResource DropdownBorder}" BorderThickness="1"
                        CornerRadius="10">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="16" ShadowDepth="4" Opacity="0.15" Direction="270"/>
                    </Border.Effect>
                    <ListView x:Name="SearchResultsList"
                              ItemsSource="{Binding SearchResults}"
                              BorderThickness="0" MaxHeight="260"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              SelectionChanged="SearchResultsList_SelectionChanged"
                              Background="Transparent">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin"  Value="0"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListViewItem">
                                            <Border x:Name="Bd" Padding="14,10"
                                                    Background="{TemplateBinding Background}"
                                                    Cursor="Hand">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ListItemHover}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="📍 " FontSize="12"/>
                                    <TextBlock Text="{Binding Name}" FontSize="13"
                                               Foreground="{DynamicResource TextPrimary}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Border>
            </Border>
        </Grid>

        <!-- ══════════════════════ FOOTER ══════════════════════ -->
        <Border Grid.Row="2"
                Background="{DynamicResource FooterBackground}"
                BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,1,0,0"
                Padding="16,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="8" Height="8" VerticalAlignment="Center" Margin="0,0,7,0">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="#2E7D32"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsOffline}" Value="True">
                                        <Setter Property="Fill" Value="#9E9E9E"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Text="{Binding StatusMessage}"
                               Foreground="{DynamicResource TextSecondary}" FontSize="12"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <TextBlock Grid.Column="1"
                           Foreground="{DynamicResource TextMuted}" FontSize="11"
                           VerticalAlignment="Center">
                    <Run Text="Ctrl+R Actualiser  ·  Échap Fermer"/>
                </TextBlock>
            </Grid>
        </Border>
    </Grid>
</Window>
