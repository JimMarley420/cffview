<Application x:Class="cffview.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <!-- Theme brushes (swapped by ThemeManager) -->
        <SolidColorBrush x:Key="AppBackground"      Color="#F2F3F5"/>
        <SolidColorBrush x:Key="CardBackground"     Color="White"/>
        <SolidColorBrush x:Key="CardBorderColor"    Color="#EEEEEE"/>
        <SolidColorBrush x:Key="TextPrimary"        Color="#1A1A1A"/>
        <SolidColorBrush x:Key="TextSecondary"      Color="#555555"/>
        <SolidColorBrush x:Key="TextMuted"          Color="#AAAAAA"/>
        <SolidColorBrush x:Key="BorderColor"        Color="#DDDDDD"/>
        <SolidColorBrush x:Key="RowHover"           Color="#F7F7F7"/>
        <SolidColorBrush x:Key="SearchBackground"   Color="White"/>
        <SolidColorBrush x:Key="FooterBackground"   Color="White"/>
        <SolidColorBrush x:Key="DropdownBackground" Color="White"/>
        <SolidColorBrush x:Key="DropdownBorder"     Color="#E0E0E0"/>
        <SolidColorBrush x:Key="IconButtonHover"    Color="#F0F0F0"/>
        <SolidColorBrush x:Key="ListItemHover"      Color="#FFF0F0"/>
        <SolidColorBrush x:Key="SeparatorColor"     Color="#F0F0F0"/>
        <SolidColorBrush x:Key="PreviewBackground"  Color="White"/>
        <!-- Fixed brand colors -->
        <SolidColorBrush x:Key="SbbRed"             Color="#EB0000"/>
        <SolidColorBrush x:Key="SbbRedDark"         Color="#C50000"/>
    </Application.Resources>
</Application>
